# Re-warms the classroom model after Ollama starts.
#
# WHY: the picker's local model (gemma4:12b, ~8GB) is loaded from disk on first
# use, and Ollama forgets it on restart — and this box gets rebooted often while
# being tweaked. Without this unit, the first student after a reboot eats the
# cold-load stall (longer still on a cold page cache), with nothing in any log to
# say why. Warming it here moves that cost off the students.
#
# (History: this used to preload TWO models in a load-bearing ORDER — vision
# first to force qwen3.5:9b to split onto the 2060S — see the git log and
# deploy/ollama-classroom/10-classroom.conf. One model now, so order is moot.)
#
# Deliberately calls `warm`, NOT `open`: opening the chat is a scheduled,
# cost-controlled decision (cron, three lab windows — the public endpoint
# exposes an Anthropic key). An Ollama restart must never open it.
#
# Install:
#   sudo cp deploy/ollama-warm.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable ollama-warm.service
#
# It fires on boot and on every `systemctl restart ollama`.
[Unit]
Description=Preload the Ollama classroom model (gemma4:12b)
# Ordering only — no Requires. If Ollama is not running there is nothing to
# warm, and the script's curl calls fail harmlessly.
After=ollama.service network-online.target
Wants=ollama.service

[Service]
Type=oneshot
User=michael
Group=michael
WorkingDirectory=/home/michael/loco-puente
ExecStart=/home/michael/loco-puente/deploy/chat-window.sh warm
# Loading ~8GB of weights from disk is quick warm, longer on a cold page cache
# after a reboot. Generous ceiling; the script's own curl timeouts (300s per
# model) bound it in practice.
TimeoutStartSec=900
# Ollama accepts connections slightly before it can serve a load request; a
# cold-boot warm can catch that window and fail. One retry covers it.
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
