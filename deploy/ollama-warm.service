# Re-warms the classroom models after Ollama starts.
#
# WHY: the two models only coexist if they are loaded in the right order — the
# vision model first, so it fills the 3090 and forces qwen3.5:9b to split onto
# the 2060S (see deploy/ollama-classroom/10-classroom.conf). Load them the other
# way round and each model switch costs a 13-20s reload instead of ~0.4s.
#
# Ollama forgets all of that on restart, and this box gets rebooted often while
# being tweaked. Without this unit, the first student to pick the TEXT model
# after a reboot silently locks the box into the slow configuration for the rest
# of the lab, with nothing in any log to say why.
#
# Deliberately calls `warm`, NOT `open`: opening the chat is a scheduled,
# cost-controlled decision (cron, three lab windows — the public endpoint
# exposes an Anthropic key). An Ollama restart must never open it.
#
# Install:
#   sudo cp deploy/ollama-warm.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable ollama-warm.service
#
# It fires on boot and on every `systemctl restart ollama`.
[Unit]
Description=Preload Ollama classroom models in GPU-placement order
# Ordering only — no Requires. If Ollama is not running there is nothing to
# warm, and the script's curl calls fail harmlessly.
After=ollama.service network-online.target
Wants=ollama.service

[Service]
Type=oneshot
User=michael
Group=michael
WorkingDirectory=/home/michael/loco-puente
ExecStart=/home/michael/loco-puente/deploy/chat-window.sh warm
# Loading ~27GB of weights from disk takes well under a minute warm, longer on
# a cold page cache after a reboot. Generous ceiling; the script's own curl
# timeouts (300s per model) bound it in practice.
TimeoutStartSec=900
# Ollama accepts connections slightly before it can serve a load request; a
# cold-boot warm can catch that window and fail. One retry covers it.
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
