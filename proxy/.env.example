# locopuente Caddy secrets — copy to .env and fill in. DO NOT commit .env.
# .env is gitignored; this .example documents the required vars with PLACEHOLDERS.
# Never put real tokens or hashes in this .example file.

# ---- Basic Auth (bcrypt hashes) ----
# Generate: docker run --rm caddy:2 caddy hash-password --plaintext 'yourpass'
# The shared "swarm" UI login (image + all UI tools):
SWARM_BCRYPT=<bcrypt-hash-here>

# boxes.borck.dev — two users, michael + callum. Set a NEW password for each:
BOXES_BCRYPT=<bcrypt-hash-here>
BOXES_CALLUM_BCRYPT=<bcrypt-hash-here>

# ---- Bearer tokens (raw token string, WITHOUT the leading "Bearer ") ----
# Generate: openssl rand -hex 32
# NOTE: swarmui/voice/chatterbox/comfyui SHARED one token in NPM (audit finding
# F-2). Give each a UNIQUE value here.
SWARMUI_TOKEN=<token-here>
VOICE_TOKEN=<token-here>
CHATTERBOX_TOKEN=<token-here>
COMFYUI_TOKEN=<token-here>
SPEACHES_TOKEN=<token-here>
WORKREADY_TOKEN=<token-here>
OLLAMA_TOKEN=<token-here>
