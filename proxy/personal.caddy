# ==========================================================================
# Personal / non-puente hosts — hand-maintained, NOT generated by puente.
# The puente-generated Caddyfile `import`s this at the end (see caddy.extra_caddyfile).
# Copy this to ~/.puente/caddy/personal.caddy on the host running Caddy.
# ==========================================================================

boxes.borck.dev {
	basic_auth {
		michael {$BOXES_BCRYPT}
	}
	reverse_proxy 192.168.20.120:8077
}

plex.serveur.au {
	# Plex — own auth
	reverse_proxy 192.168.20.3:32400
}

books.serveur.au {
	# personal host on serveur.au
	reverse_proxy 192.168.20.3:5000
}
