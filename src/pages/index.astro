---
// LocoPuente home / marketing funnel. Standalone Astro page (owns "/"),
// intentionally distinct from the Starlight docs theme. Zero-build for the page
// itself: plain HTML/CSS/JS, no components, no web fonts, no client deps.
// Mission content lives at /about; docs at /services, /stack, etc.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>LocoPuente — Your own AI platform. Local hardware, no token tax.</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Puente stands up a full local AI platform on modest hardware from one config file. Pay a time tax, not a token tax. Private by design — self-hosted and yours.">
<meta name="theme-color" content="#0d1b1e">
<meta property="og:type" content="website">
<meta property="og:title" content="LocoPuente — Your own AI platform">
<meta property="og:description" content="A local-first AI orchestrator. Chat, image, speech, search — on your own hardware. Pay a time tax, not a token tax.">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg">
<style>
  :root {
    /* dark is the committed default; light tokens below */
    --ground: #0d1b1e;
    --surface: #12262a;
    --surface-2: #17313640;
    --line: #234247;
    --line-strong: #2f565c;
    --ink: #e8f0ee;
    --ink-2: #a9c2be;
    --ink-3: #6f8f8b;
    --amber: #f0a828;
    --amber-soft: #f0a82818;
    --teal: #46b3b0;
    --green: #4ea87a;
    /* System fonts only — no web fonts loaded (zero-build, no CDN). */
    --display: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --mono: ui-monospace, "SF Mono", "Cascadia Code", "JetBrains Mono", Menlo, Consolas, monospace;
  }
  :root[data-theme="light"] {
    --ground: #f3f6f5;
    --surface: #ffffff;
    --surface-2: #e9f0ee80;
    --line: #d5e2df;
    --line-strong: #b9ccc8;
    --ink: #12262a;
    --ink-2: #3d5a56;
    --ink-3: #6f8f8b;
    --amber: #c67d10;
    --amber-soft: #c67d1015;
    --teal: #1f8a87;
    --green: #2f855a;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0; background: var(--ground); color: var(--ink);
    font-family: var(--sans); line-height: 1.6; font-size: 16px;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }
  .wrap { width: 100%; max-width: 1140px; margin: 0 auto; padding: 0 24px; }

  nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  nav .row { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand { display: flex; align-items: center; gap: 11px; font-family: var(--display); font-weight: 600; font-size: 19px; letter-spacing: -0.01em; }
  .brand .glyph { width: 26px; height: 26px; }
  .navlinks { display: flex; align-items: center; gap: 28px; font-size: 14.5px; color: var(--ink-2); }
  .navlinks a:hover { color: var(--ink); }
  .navlinks .btn { color: var(--ground); }
  @media (max-width: 720px) { .navlinks a:not(.btn) { display: none; } }

  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--amber); color: #1a1205; font-weight: 600;
    padding: 10px 18px; border-radius: 8px; font-size: 14.5px;
    border: 1px solid transparent; transition: transform .12s ease, box-shadow .12s ease;
    font-family: var(--sans);
  }
  .btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px -8px var(--amber); }
  .btn.ghost { background: transparent; color: var(--ink); border-color: var(--line-strong); }
  .btn.ghost:hover { border-color: var(--amber); box-shadow: none; color: var(--ink); }
  .btn:focus-visible, a:focus-visible, button:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  .hero { position: relative; padding: 74px 0 64px; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; gap: 40px; } }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--mono); font-size: 12.5px; letter-spacing: 0.02em;
    color: var(--teal); border: 1px solid var(--line-strong);
    padding: 5px 12px; border-radius: 30px; margin-bottom: 22px;
    background: var(--surface-2);
  }
  .eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 8px var(--green); }
  h1 {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(34px, 5.4vw, 58px); line-height: 1.03;
    letter-spacing: -0.035em; margin: 0 0 22px; text-wrap: balance;
  }
  h1 em { font-style: normal; color: var(--amber); position: relative; white-space: nowrap; }
  .lead { font-size: clamp(16px, 2vw, 19px); color: var(--ink-2); max-width: 46ch; margin: 0 0 20px; }
  .taxline {
    font-family: var(--mono); font-size: 14.5px; color: var(--ink);
    margin: 0 0 30px; padding-left: 15px; border-left: 2px solid var(--amber);
  }
  .taxline b { color: var(--amber); font-weight: 600; }
  .taxline s { color: var(--ink-3); text-decoration-color: var(--ink-3); }
  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
  .cta-note { font-family: var(--mono); font-size: 12.5px; color: var(--ink-3); margin-top: 16px; }

  .term {
    border: 1px solid var(--line-strong); border-radius: 12px;
    overflow: hidden; box-shadow: 0 30px 70px -30px #000a, 0 0 0 1px #0003;
    background: linear-gradient(180deg, var(--surface), color-mix(in srgb, var(--ground) 70%, var(--surface)));
  }
  .term-bar { display: flex; align-items: center; gap: 7px; padding: 12px 15px; border-bottom: 1px solid var(--line); }
  .term-bar i { width: 11px; height: 11px; border-radius: 50%; background: var(--line-strong); display: block; }
  .term-bar i:nth-child(1) { background: #e05c54; } .term-bar i:nth-child(2) { background: #e0a83a; } .term-bar i:nth-child(3) { background: #4ea87a; }
  .term-bar span { margin-left: 8px; font-family: var(--mono); font-size: 12px; color: var(--ink-3); }
  .term-body { padding: 20px 20px 24px; font-family: var(--mono); font-size: 13.5px; line-height: 1.85; min-height: 316px; }
  .term-body .p { color: var(--teal); }
  .term-body .c { color: var(--ink); }
  .term-body .o { color: var(--ink-2); }
  .term-body .ok { color: var(--green); }
  .term-body .am { color: var(--amber); }
  .cursor { display: inline-block; width: 8px; height: 16px; background: var(--amber); vertical-align: text-bottom; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

  section { padding: 78px 0; }
  .sec-head { max-width: 60ch; margin-bottom: 44px; }
  .kicker { font-family: var(--mono); font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--amber); margin: 0 0 12px; }
  h2 { font-family: var(--display); font-weight: 700; font-size: clamp(26px, 3.4vw, 36px); letter-spacing: -0.03em; margin: 0 0 14px; line-height: 1.1; text-wrap: balance; }
  .sec-head p { color: var(--ink-2); font-size: 17px; margin: 0; }

  .band { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface-2); }

  .tax { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  @media (max-width: 760px) { .tax { grid-template-columns: 1fr; } }
  .tax > div { padding: 40px; }
  .tax > div:first-child { border-right: 1px solid var(--line); }
  @media (max-width: 760px) { .tax > div:first-child { border-right: none; border-bottom: 1px solid var(--line); } }
  .tax h3 { font-family: var(--display); font-size: 22px; margin: 0 0 10px; font-weight: 600; }
  .tax .big { font-family: var(--mono); font-size: 13px; color: var(--ink-3); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 14px; }
  .tax .you h3 { color: var(--amber); }
  .tax p { color: var(--ink-2); margin: 0; font-size: 15px; }

  .svc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
  .svc {
    border: 1px solid var(--line); border-radius: 10px; padding: 18px;
    background: var(--surface); transition: border-color .15s ease, transform .15s ease;
  }
  .svc:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .svc .ico { font-size: 20px; margin-bottom: 10px; display: block; }
  .svc h4 { font-family: var(--display); font-size: 15.5px; margin: 0 0 4px; font-weight: 600; }
  .svc p { font-size: 13px; color: var(--ink-3); margin: 0; }

  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; counter-reset: step; }
  @media (max-width: 820px) { .steps { grid-template-columns: 1fr; } }
  .step { border: 1px solid var(--line); border-radius: 12px; padding: 26px; background: var(--surface); position: relative; }
  .step::before {
    counter-increment: step; content: "0" counter(step);
    font-family: var(--mono); font-size: 13px; color: var(--amber);
    position: absolute; top: 20px; right: 22px;
  }
  .step h4 { font-family: var(--display); font-size: 18px; margin: 0 0 8px; font-weight: 600; }
  .step .cmd { font-family: var(--mono); font-size: 13px; color: var(--teal); margin: 0 0 12px; }
  .step p { font-size: 14px; color: var(--ink-2); margin: 0; }

  .code {
    background: var(--surface); border: 1px solid var(--line-strong); border-radius: 12px;
    padding: 22px 24px; font-family: var(--mono); font-size: 13.5px; line-height: 1.9;
    overflow-x: auto; color: var(--ink); white-space: pre;
  }
  .code .p { color: var(--teal); } .code .cm { color: var(--ink-3); } .code .am { color: var(--amber); }
  .selfhost { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  @media (max-width: 860px) { .selfhost { grid-template-columns: 1fr; } }
  .feat-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .feat-list li { display: flex; gap: 12px; font-size: 15px; color: var(--ink-2); }
  .feat-list .chk { color: var(--green); flex-shrink: 0; font-family: var(--mono); }
  .feat-list b { color: var(--ink); font-weight: 600; }

  footer { border-top: 1px solid var(--line); padding: 44px 0; color: var(--ink-3); font-size: 14px; }
  footer .row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 18px; }
  footer a:hover { color: var(--ink); }
  .theme-toggle { background: none; border: 1px solid var(--line-strong); color: var(--ink-2); font-family: var(--mono); font-size: 12px; padding: 6px 11px; border-radius: 7px; cursor: pointer; }
  .theme-toggle:hover { border-color: var(--amber); color: var(--ink); }

  .hero::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0;
    background:
      radial-gradient(600px 300px at 78% 30%, var(--amber-soft), transparent 70%),
      radial-gradient(500px 400px at 10% 60%, color-mix(in srgb, var(--teal) 8%, transparent), transparent 70%);
  }
  .hero .wrap { position: relative; z-index: 1; }
</style>
</head>
<body>

<nav>
  <div class="wrap row">
    <a class="brand" href="/">
      <svg class="glyph" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M2 21 C 9 21, 9 12, 16 12 C 23 12, 23 21, 30 21" stroke="var(--amber)" stroke-width="2.4" stroke-linecap="round"/>
        <path d="M2 25 H 30" stroke="var(--teal)" stroke-width="2.4" stroke-linecap="round"/>
        <path d="M8 21 V 25 M16 12 V 25 M24 21 V 25" stroke="var(--teal)" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      LocoPuente
    </a>
    <div class="navlinks">
      <a href="#services">Services</a>
      <a href="#how">How it works</a>
      <a href="/about">Why</a>
      <a href="/services">Docs</a>
      <a href="https://github.com/michael-borck/loco-puente">GitHub</a>
      <a class="btn" href="#how">Get started</a>
    </div>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow"><span class="dot"></span> Local-first AI orchestrator</span>
      <h1>Your own AI platform. <em>Runs on your hardware.</em></h1>
      <p class="lead">Puente stands up a full local AI stack — chat, image, speech, search, notebooks — from one config file. Private by default. Yours to keep.</p>
      <p class="taxline">Pay a <b>time tax</b>, not a <s>token tax</s>. Modest hardware, honest bills.</p>
      <div class="cta-row">
        <a class="btn" href="#how">Get started →</a>
        <a class="btn ghost" href="#selfhost">Self-host guide</a>
      </div>
      <p class="cta-note">$ pip install -e . &nbsp;·&nbsp; runs on a single consumer GPU</p>
    </div>

    <div class="term" aria-label="Terminal demonstration of the puente workflow">
      <div class="term-bar"><i></i><i></i><i></i><span>puente — bash</span></div>
      <div class="term-body" id="term"></div>
    </div>
  </div>
</header>

<div class="band">
  <div class="wrap">
    <div class="tax">
      <div class="cloud">
        <div class="big">The cloud way</div>
        <h3>A token tax</h3>
        <p>Every prompt metered. Costs scale with use, data leaves your walls, and the bill never stops. Fast — but rented, and never yours.</p>
      </div>
      <div class="you">
        <div class="big">The Puente way</div>
        <h3>A time tax</h3>
        <p>Slower on cheap silicon, sure. But it's a one-time cost you already paid: the machine on your desk. No metering, no egress, no surprises.</p>
      </div>
    </div>
  </div>
</div>

<section id="services">
  <div class="wrap">
    <div class="sec-head">
      <p class="kicker">One stack, many tools</p>
      <h2>Fire up the AI services you need</h2>
      <p>Toggle services in <code style="font-family:var(--mono);color:var(--teal)">puente.yml</code>. Puente handles the containers, GPUs, models, and a reverse proxy — you get URLs.</p>
    </div>
    <div class="svc-grid" id="svcgrid"></div>
  </div>
</section>

<div class="band">
<section id="how" style="border:0">
  <div class="wrap">
    <div class="sec-head">
      <p class="kicker">Three commands</p>
      <h2>From bare machine to running platform</h2>
      <p>Puente detects your hardware, picks services that fit, and brings the stack up. No hand-wiring containers.</p>
    </div>
    <div class="steps">
      <div class="step">
        <h4>Detect &amp; plan</h4>
        <p class="cmd">$ puente init</p>
        <p>Scans your CPU, RAM, and GPUs, then proposes a service set your hardware can actually run. Writes <b style="color:var(--ink)">puente.yml</b>.</p>
      </div>
      <div class="step">
        <h4>Install</h4>
        <p class="cmd">$ puente install</p>
        <p>Pulls Docker images, installs native pieces (Ollama, models, ComfyUI). Pins each model to the right GPU.</p>
      </div>
      <div class="step">
        <h4>Launch</h4>
        <p class="cmd">$ puente up</p>
        <p>Starts the stack and a launcher portal. Run <b style="color:var(--ink)">puente status</b> to see what's live. That's it.</p>
      </div>
    </div>
  </div>
</section>
</div>

<section id="selfhost">
  <div class="wrap selfhost">
    <div>
      <p class="kicker">Self-host</p>
      <h2>Private by architecture, not by promise</h2>
      <ul class="feat-list">
        <li><span class="chk">✓</span><span><b>Your data never leaves the box.</b> Inference runs on hardware you own.</span></li>
        <li><span class="chk">✓</span><span><b>Bring your own proxy — or use ours.</b> Caddy ships as an optional service with automatic TLS.</span></li>
        <li><span class="chk">✓</span><span><b>Config as code.</b> The whole stack is one committable <span style="font-family:var(--mono);color:var(--teal)">puente.yml</span>.</span></li>
        <li><span class="chk">✓</span><span><b>Runs on modest hardware.</b> A single consumer GPU is enough to start.</span></li>
      </ul>
    </div>
    <pre class="code"><span class="cm"># clone &amp; install</span>
<span class="p">$</span> git clone https://github.com/michael-borck/loco-puente.git
<span class="p">$</span> cd loco-puente &amp;&amp; pip install -e .

<span class="cm"># set it up and go</span>
<span class="p">$</span> puente <span class="am">init</span>     <span class="cm"># detect hardware, choose services</span>
<span class="p">$</span> puente <span class="am">install</span>  <span class="cm"># pull images + models</span>
<span class="p">$</span> puente <span class="am">up</span>       <span class="cm"># your platform is live</span></pre>
  </div>
</section>

<footer>
  <div class="wrap row">
    <div class="brand" style="font-size:16px">
      <svg class="glyph" viewBox="0 0 32 32" fill="none" aria-hidden="true" style="width:22px;height:22px">
        <path d="M2 21 C 9 21, 9 12, 16 12 C 23 12, 23 21, 30 21" stroke="var(--amber)" stroke-width="2.4" stroke-linecap="round"/>
        <path d="M2 25 H 30" stroke="var(--teal)" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
      LocoPuente
    </div>
    <div style="display:flex;gap:24px;align-items:center">
      <a href="/about">Why</a>
      <a href="/services">Docs</a>
      <a href="https://github.com/michael-borck/loco-puente">GitHub</a>
      <button class="theme-toggle" id="themeBtn" type="button">◑ theme</button>
    </div>
  </div>
  <div class="wrap" style="margin-top:20px;font-size:12.5px;color:var(--ink-3)">
    LocoPuente is a LocoLabo initiative. Pay a time tax, not a token tax.
  </div>
</footer>

<script is:inline>
  // theme toggle (dark committed default; light available)
  const root = document.documentElement;
  document.getElementById('themeBtn').addEventListener('click', () => {
    const now = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', now);
  });

  // services grid
  const SERVICES = [
    ['🧠','Ollama','Local LLM inference'],
    ['💬','Open WebUI','Chat over your models'],
    ['🎨','SwarmUI','Image generation'],
    ['🖼️','ComfyUI','Node-based image pipelines'],
    ['🗣️','Chatterbox','Voice-cloning TTS'],
    ['👂','Speaches','Speech-to-text + TTS'],
    ['🔎','SearXNG','Private meta-search'],
    ['📚','AnythingLLM','Docs + RAG workspaces'],
    ['📓','Open Notebook','Research notebooks'],
    ['📄','Stirling PDF','PDF toolkit'],
    ['🎼','MusicGen','Audio generation'],
    ['🧩','+ more','Fooocus, Excalidraw, Jupyter…'],
  ];
  const grid = document.getElementById('svcgrid');
  grid.innerHTML = SERVICES.map(([i,n,d]) =>
    '<div class="svc"><span class="ico">' + i + '</span><h4>' + n + '</h4><p>' + d + '</p></div>').join('');

  // hero terminal type-on
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const term = document.getElementById('term');
  const SEQ = [
    {t:'p',x:'$ '},{t:'c',x:'puente init\n'},
    {t:'o',x:'→ detected: '},{t:'am',x:'2× RTX 2060 · 32GB RAM\n'},
    {t:'o',x:'→ proposing services that fit your hardware…\n'},
    {t:'ok',x:'✓ wrote puente.yml  (9 services)\n\n'},
    {t:'p',x:'$ '},{t:'c',x:'puente up\n'},
    {t:'o',x:'  starting ollama       '},{t:'ok',x:'ready\n'},
    {t:'o',x:'  starting open-webui    '},{t:'ok',x:'ready\n'},
    {t:'o',x:'  starting swarmui       '},{t:'ok',x:'ready\n'},
    {t:'o',x:'  starting comfyui       '},{t:'ok',x:'ready\n'},
    {t:'am',x:'\n▲ your AI platform is live → http://localhost:8080\n'},
  ];
  function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function render(nodes, partial) {
    let html = nodes.map(n => '<span class="' + n.t + '">' + esc(n.x) + '</span>').join('');
    if (partial !== null) html += '<span class="' + partial.t + '">' + esc(partial.x) + '</span>';
    return html + '<span class="cursor"></span>';
  }
  if (reduce) {
    term.innerHTML = render(SEQ, null);
  } else {
    let done = [], i = 0, j = 0;
    function tick() {
      if (i >= SEQ.length) { term.innerHTML = render(done, null); return; }
      const cur = SEQ[i];
      term.innerHTML = render(done, {t:cur.t, x:cur.x.slice(0, j)});
      if (j < cur.x.length) { j++; setTimeout(tick, cur.x[j-1] === '\n' ? 120 : (18 + ((i*7+j)%22))); }
      else { done.push(cur); i++; j = 0; setTimeout(tick, cur.t === 'c' ? 340 : 60); }
    }
    tick();
  }
</script>
</body>
</html>
