<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⛩️</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #0a0a0b;
      --bg-card: #16161a;
      --bg-card-hover: #1c1c21;
      --text-primary: #e8e6e3;
      --text-secondary: #9a9a9e;
      --text-muted: #5e5e63;
      --accent: #f43f5e;
      --accent-glow: rgba(244, 63, 94, 0.15);
      --border: #1e1e23;
      --border-light: #2a2a30;
      --font-mono: 'JetBrains Mono', monospace;
      --font-sans: 'DM Sans', -apple-system, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-sans);
      background: var(--bg-primary);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex; flex-direction: column;
      align-items: center;
      padding: 2rem;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 9999;
    }

    .header {
      text-align: center;
      margin-top: 3rem;
      margin-bottom: 1.5rem;
    }
    .header h1 {
      font-family: var(--font-mono);
      font-size: 1.75rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .header h1 .accent { color: var(--accent); }
    .header p {
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    /* Filter buttons */
    .filters {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 2.5rem;
    }
    .filter-btn {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      padding: 0.4rem 1rem;
      border-radius: 100px;
      border: 1px solid var(--border-light);
      background: var(--bg-card);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn:hover {
      border-color: var(--text-muted);
      color: var(--text-primary);
    }
    .filter-btn.active {
      background: var(--accent-glow);
      border-color: var(--accent);
      color: var(--accent);
    }

    .content {
      max-width: 740px;
      width: 100%;
    }

    .section {
      margin-bottom: 2.5rem;
      display: none;
    }
    .section.visible { display: block; }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 1rem;
      padding-left: 0.25rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1.25rem;
      width: 100%;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.75rem 1.5rem;
      text-decoration: none;
      color: inherit;
      transition: all 0.25s;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.5rem;
    }
    .card:hover {
      border-color: var(--accent);
      transform: translateY(-3px);
      box-shadow: 0 8px 30px rgba(244, 63, 94, 0.1);
    }
    .card-icon { font-size: 2.25rem; }
    .card-name {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 600;
    }
    .card-desc {
      font-size: 0.8rem;
      color: var(--text-secondary);
      line-height: 1.4;
    }

    .footer {
      margin-top: 2rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.8rem;
    }
    .footer a { color: var(--text-muted); text-decoration: none; }
    .footer a:hover { color: var(--text-secondary); }

    .gpu-strip {
      display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center;
      margin: 0 auto 1.25rem; max-width: 900px;
    }
    .gpu-card {
      display: flex; align-items: center; gap: 0.6rem;
      background: var(--card-bg, rgba(255,255,255,0.04));
      border: 1px solid rgba(255,255,255,0.08); border-radius: 8px;
      padding: 0.4rem 0.75rem; font-size: 0.8rem; color: var(--text-secondary);
    }
    .gpu-card .gpu-id { font-weight: 600; color: var(--text-primary, #fff); }
    .gpu-bar {
      width: 90px; height: 6px; border-radius: 3px;
      background: rgba(255,255,255,0.12); overflow: hidden;
    }
    .gpu-bar > span { display: block; height: 100%; background: var(--accent, #6ea8fe); }
    .gpu-meta { white-space: nowrap; }

    @media (max-width: 600px) {
      .grid { grid-template-columns: repeat(2, 1fr); }
      .header h1 { font-size: 1.5rem; }
      .filters { flex-wrap: wrap; justify-content: center; }
    }
  </style>
</head>
<body>
  <div class="header">
    <h1><span class="accent">⛩️</span> {{ title }}</h1>
    <p>{{ subtitle }}</p>
  </div>

  <div id="gpu-strip" class="gpu-strip" style="display:none"></div>

  <div class="filters">
    {% for view in views %}
    <button class="filter-btn{% if loop.first %} active{% endif %}" data-view="{{ view.id }}">{{ view.label }}</button>
    {% endfor %}
  </div>

  <div class="content">
    {% for view in views %}
    {% for section in view.sections %}
    <div class="section{% if view.id == views[0].id %} visible{% endif %}" data-view="{{ view.id }}">
      {% if section.label %}
      <div class="section-label">{{ section.label }}</div>
      {% endif %}
      <div class="grid">
        {% for svc in section.services %}
        <a href="{{ svc.url }}" class="card" target="_blank" rel="noopener">
          <div class="card-icon">{{ svc.icon }}</div>
          <div class="card-name">{{ svc.name }}</div>
          <div class="card-desc">{{ svc.description }}</div>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
    {% endfor %}
  </div>

  <div class="footer">
    Powered by <a href="https://locopuente.org">LocoPuente</a> — local AI, all data stays on this machine
  </div>

  <script>
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view;
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.section').forEach(s => {
          s.classList.toggle('visible', s.dataset.view === view);
        });
      });
    });

    // GPU stats strip — fetches gpu-stats.json (written by the portal-gpu-stats
    // sidecar every ~3s). Hidden if the file is absent (no GPU / sidecar off).
    async function refreshGpu() {
      try {
        const r = await fetch('gpu-stats.json?_=' + Date.now(), { cache: 'no-store' });
        if (!r.ok) return;
        const gpus = await r.json();
        if (!Array.isArray(gpus) || !gpus.length) return;
        const strip = document.getElementById('gpu-strip');
        strip.innerHTML = gpus.map(g => {
          const pct = g.mem_total ? Math.round(100 * g.mem_used / g.mem_total) : 0;
          const gb = m => (m / 1024).toFixed(1);
          return `<div class="gpu-card">
            <span class="gpu-id">GPU ${g.index}</span>
            <span class="gpu-bar"><span style="width:${pct}%"></span></span>
            <span class="gpu-meta">${gb(g.mem_used)}/${gb(g.mem_total)} GB · ${g.util}% · ${g.temp}°C</span>
          </div>`;
        }).join('');
        strip.style.display = 'flex';
      } catch (e) { /* no GPU stats available — leave strip hidden */ }
    }
    refreshGpu();
    setInterval(refreshGpu, 3000);
  </script>
</body>
</html>
